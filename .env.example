# This is an example environment file for the demo application. You should copy this file to .env.local and fill in the values for the secrets.
# Long random secret used to sign invite links.
DEMO_INVITE_SECRET=

# Long random secret used to sign session cookies.
DEMO_SESSION_SECRET=

# Base URL used when generating demo links.
DEMO_BASE_URL=http://localhost:3000

# Invite link expiry in hours.
DEMO_INVITE_MAX_AGE_HOURS=72

# Session expiry in hours.
DEMO_SESSION_MAX_AGE_HOURS=12
